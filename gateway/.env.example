# Sao chép thành ".env" đặt cạnh glabs-gateway.exe rồi sửa. KHÔNG đưa .env vào repo/chat.

# G-Labs Automation chạy trên chính máy này (giữ 127.0.0.1)
GW_GLABS_URL=http://127.0.0.1:8765
# API Key trong tab "Webhook API" của G-Labs
GW_GLABS_KEY=

# Khóa CÔNG KHAI do thoai-dash ký token (lấy từ tools/gen_veo_keys.py hoặc GET https://d100radar.com/api/veo/public-key)
GW_JWT_PUBKEY_FILE=veo_public.pem

# Thư mục lưu dữ liệu và kết quả (giữ 7 ngày)
GW_DATA_DIR=D:\GatewayData
GW_RETENTION_DAYS=7

# Trần luồng chạy đồng thời toàn hệ thống. Bắt đầu thấp, tăng dần sau khi đo RAM/CPU máy nhà.
GW_MAX_INFLIGHT_VIDEO=5
GW_MAX_INFLIGHT_IMAGE=8
GW_VIDEO_TIMEOUT=480
GW_POLL_SECONDS=5

# Địa chỉ công khai (chỉ để hiển thị)
GW_PUBLIC_URL=https://veo.d100radar.com
